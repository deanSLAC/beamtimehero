# BeamtimeHero at BL4-1 (bl41lx1). Copy to .env (as fourone, mode 600):
#   cp .env.bl41.example .env && chmod 600 .env
# Variable names match ../autonomous_fourone/.env and ../controllatopia/.env.

# ---- Station ----------------------------------------------------------------
# Selects the BL4-1 persona, read-only tool profile, reference docs and paths
# (beamline_tools/stations/bl41.py), and beamtimehero_cli's BL4-1 defaults.
BTH_STATION=bl41

# Defaults from the station (uncomment only to override):
# BL_SCAN_DIR=/fourone                      # newest /fourone/YYYY-MM_* is used
# BL_LOGS_DIR=/usr/local/lib/spec.log/logfiles
# BEAMTIMEHERO_DATA_DIR=/fourone/beamtimehero/data
# BEAMTIMEHERO_LOG_DIR=/fourone/beamtimehero/logs
# SPEC_TRANSPORT=tcp                        # SPEC server, localhost:2033
# PORT=8742                                 # run.sh; HOST stays 127.0.0.1

# ---- LLM gateway: SLAC AI Gateway (Bedrock) ----------------------------------
LLM_GATEWAY=slac
# Path to the `claude` binary if it is not on fourone's PATH / ~/.local/bin.
# CLAUDE_BIN=claude

SLAC_BASE_URL=https://ai-api.slac.stanford.edu
# Primary is tried first; SLAC_API_KEY is the fallback while the primary is
# rate-limited. Same keys as ../autonomous_fourone/.env (originally from
# ~/.claude/settings-api-slac.json and settings-api-slac-AWHw.json).
SLAC_API_KEY_PRIMARY=
SLAC_API_KEY=
SLAC_MODEL_ALIAS=opus
# Every other SLAC_* var is passed to claude with the prefix stripped.
SLAC_ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-5-5[1m]
SLAC_ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-5
SLAC_ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
SLAC_CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
# The gateway resolves to private AWS addresses that bl41lx1 reaches only
# through the beamline proxy: take .slac.stanford.edu out of NO_PROXY, and
# set the proxy explicitly (a systemd service has no login-shell proxy env).
SLAC_NO_PROXY=127.0.0.1,localhost,192.168.41.0/24
SLAC_no_proxy=127.0.0.1,localhost,192.168.41.0/24
SLAC_HTTPS_PROXY=http://134.79.44.164:3128
SLAC_https_proxy=http://134.79.44.164:3128
# The server itself (Slack bridge: slack.com) also needs the proxy;
# load_dotenv() puts these into its own environment.
HTTPS_PROXY=http://134.79.44.164:3128
https_proxy=http://134.79.44.164:3128
NO_PROXY=127.0.0.1,localhost,192.168.41.0/24
no_proxy=127.0.0.1,localhost,192.168.41.0/24

# ---- Slack staff bridge (optional; leave empty to run without Slack) --------
# A BL4-1 bot of its own (not BL15-2's). See README "Slack setup".
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# #beamtimehero-41 style channel: user <-> LLM conversation mirror
SLACK_LLM_CHANNEL_ID=
# staff <-> user relay channel (the web UI's "Staff Chat" pane)
SLACK_USERS_CHANNEL_ID=

# ---- MLflow tracing (off) ---------------------------------------------------
MLFLOW_ENABLED=0
